; Engine configuration file.
config_version=5

[application]

config/name="Menus 3D"
config/version="1.0.0"
run/main_scene="res://scenes/menus/front_board.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
crash_reporter/enabled=true
crash_reporter/upload_mode=2
crash_reporter/require_user_consent=true
crash_reporter/spawn_on_crash=true
crash_reporter/reporter_filename="crash_reporter"
crash_reporter/reporter_filename.windows="crash_reporter.exe"
crash_reporter/endpoint="https://api.blazium.online/api/v1/public/crashes"
crash_reporter/app_id=""
crash_reporter/build_id=""
crash_reporter/app_name="Menus 3D"
crash_reporter/app_version="1.0.0"
crash_reporter/build_channel="dev"
crash_reporter/privacy_policy_url="https://blazium.games/privacy-policy"

[autoload]

LaunchEvents="*res://autoload/launch_events.gd"
BootGuard="*res://autoload/boot_guard.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"

